{
  "manifest_version": 3,
  "name": "Automation Backend Helper",
  "version": "1.1.0",
  "description": "Element Inspector, action recorder, and Remote→Local session handoff for automation-backend. Inspect any element (Ctrl+Shift+C), and move a running remote browser session onto this machine with a pairing code — same tabs, same order, same active tab.",
  "permissions": ["storage", "activeTab", "scripting", "tabs"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content/inspector.js", "content/presence.js", "content/consent.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["content/inspector.css", "icons/*"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+X",
        "mac": "Command+Shift+X"
      },
      "description": "Open Inspector popup"
    },
    "toggle-inspect": {
      "suggested_key": {
        "default": "Ctrl+Shift+C",
        "mac": "Command+Shift+C"
      },
      "description": "Toggle element inspection"
    }
  }
}
