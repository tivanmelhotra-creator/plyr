{
  "manifest_version": 3,
  "name": "Automation Backend Helper",
  "version": "1.1.0",
  "description": "Element Inspector, action recorder, and Remote→Local session handoff for automation-backend. Inspect any element (Ctrl+Shift+C), and move a running remote browser session onto this machine with a pairing code — same tabs, same order, same active tab.",
  "permissions": ["storage", "activeTab", "scripting", "tabs"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "action": {
    "default_title": "Element Inspector",
    "default_popup": "popup/popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": [
        "lib/ab-inspect.js",
        "content/selector.js",
        "content/inspector.js",
        "content/recorder.js",
        "content/presence.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "commands": {
    "toggle-inspector": {
      "suggested_key": { "default": "Ctrl+Shift+C", "mac": "Command+Shift+C" },
      "description": "Inspect an element and send it to the active node"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
