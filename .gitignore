# ───────── Dependencies ─────────
node_modules/

# ───────── Build output ─────────
dist/
*.tsbuildinfo

# ───────── Secrets & env ─────────
.env
.env.local
.env.*.local

# ───────── Runtime data ─────────
logs/
profiles/
# Files a user pushed across from their own machine so the remote page's file
# dialog could receive them. Swept on a TTL; never source.
uploads/
*.log

# ───────── Redis bundled binaries (Windows) ─────────
# Heavy ~48MB Windows binaries — should NOT be in repo.
# Install Redis from the official source on the target machine instead.
Redis/

# ───────── Misc ─────────
.DS_Store
chromium/
.env.example.tmp

# Redis dump (test artifact)
dump.rdb

# Diagnostic renders from tools/ui-shot.js and tools/picker-panel-shot.js.
# Measurement artefacts, not deliverables.
.ui-shots/

# ───────── Crash dumps ─────────
# A killed Chrome/node can drop a multi-hundred-MB `core` in the repo root.
# It is never a deliverable, and on a small box it silently eats all the RAM
# and disk that the test suite needs. Ignore it so it is never committed.
#
# ANCHORED to the repo root (`/core`), not bare `core`. A bare pattern matches a
# DIRECTORY of that name at any depth, so it silently swallowed every new file
# under `src/core/` — already-tracked files kept working, which is what made it
# invisible: only brand-new modules vanished, and only from `git status`.
/core
/core.*
downloads/

# Mutation-testing scratch files (tools/mutate-*.py). They are copies of tracked
# SOURCE, restored in a finally/atexit — but a hard kill can strand one, and it
# HAS: a frozen sandbox left src/core/RealChrome.ts.mutbak behind mid-run. Left
# untracked and unignored, the next `git add -A` would commit a stale duplicate
# of a source file, which is a confusing thing to find later.
*.mutbak
