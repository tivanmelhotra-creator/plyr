# ============================================
# SERVER
# ============================================
PORT=3000
NODE_ENV=development

# ============================================
# PROFILE  (which situation are we in?)
# ============================================
# Most of the switches below tune THEMSELVES from this one word, so you can
# reach a sane setup without hunting through the whole file.
#
#   development  visible browser, desktop on, no rate limit   (the default)
#   server       ON A REMOTE SERVER: headed browser on a virtual display, so
#                extensions and the Element Inspector actually load. Rate limit
#                on, debug port shut. THIS IS THE ONE YOU WANT ON A SERVER.
#   production   hidden/headless browser, desktop off, rate limit on.
#                WARNING: a headless Chrome loads NO extensions at all
#                (measured: 0 headless vs 1 headed), so the Element Inspector
#                and cookie extensions are unavailable. Correct for a machine
#                that only runs the job queue; wrong if you want Remote Browser.
#   test         headless, no fixed debug port, no rate limit
#
# Short forms work too: dev, prod, ci, and `remote` for server.
#
# `server` can ONLY be selected through APP_ENV, never through NODE_ENV — a
# PaaS that sets NODE_ENV to something odd must not silently start an X server.
#
# Why APP_ENV and not NODE_ENV? NODE_ENV is written by everything -- vitest
# forces it to "test", bundlers force it to "production" -- so it cannot be
# trusted to describe YOUR intent. APP_ENV is yours alone and wins when both
# are set. NODE_ENV is still honoured when APP_ENV is absent.
APP_ENV=development

# ANY variable you set explicitly always beats the profile -- the profile only
# fills in what you left alone. That is why the self-tuning switches below are
# left COMMENTED OUT: uncommenting one pins it in every environment, including
# production. Each says what the profile would have chosen for you.
# See GET /config/profile for the live answer, with the reason for each value.

# ============================================
# REDIS
# ============================================
REDIS_URL=redis://127.0.0.1:6379

# ============================================
# DIRECTORIES
# ============================================
PROFILES_DIR=./profiles
LOGS_DIR=./logs

# Where files the user uploads are stored.
UPLOADS_DIR=./uploads

# Where files a job DOWNLOADS are collected for the user to pick up.
DOWNLOADS_DIR=./downloads

# Downloads are staged here first. Defaults to the OS temp directory, which is
# usually what you want: a download in flight is not yet a user's file.
DOWNLOADS_TMP_DIR=

# Treat a fetched file as a short-lived hand-off rather than storage. When true
# (the default) files are deleted when the session that produced them closes.
# Set false to keep them on disk until the TTL sweep.
DOWNLOADS_EPHEMERAL=true

# How long a fetched file stays fetchable, in MINUTES. Long enough to survive a
# user who walked away mid-task; short enough that the temp directory does not
# quietly become permanent storage.
DOWNLOAD_TTL_MINUTES=30

# ============================================
# CHROME (Optional)
# ============================================
# Leave EMPTY to use Playwright's bundled Chromium (recommended for Node-base/Linux).
# Set only to force a system-installed Chrome/Chromium, e.g. /usr/bin/google-chrome
CHROME_EXE=

# ============================================
# REAL CHROME — extensions + a browser you can reach on a port
# ============================================
# The picker's canvas is a screencast of a PAGE. It can never show a Chrome
# extension's toolbar popup, chrome://extensions, or a native file dialog,
# because none of those are drawn by the page. Turn this on when you need a
# genuine Chrome with genuine extensions — the usual reason is a cookie
# export/import extension: log in once anywhere, export, import here, no login.
REAL_CHROME_ENABLED=true

# Persistent profile. Cookies, localStorage and extension storage live here and
# survive restarts. Deleting this directory is "sign out of everything".
REAL_CHROME_USER_DATA_DIR=./profiles/chrome-profile

# One directory per unpacked extension, each with a manifest.json. Uploaded
# .crx/.zip files are unpacked into here by the UI.
REAL_CHROME_EXTENSIONS_DIR=./profiles/extensions

# Optional catalogue the extension picker offers for one-click install.
# Empty = no catalogue; users upload their own .crx/.zip instead.
EXTENSION_STORE_URL=

# Refuse to START when the browser runtime is broken, instead of starting and
# reporting the Remote Browser as unavailable.
#
# Default false, deliberately: this server also runs the dashboard, the API and
# the job queue, and it can install the missing pieces at runtime, so exiting
# would remove the UI you would use to watch that happen — and under Docker or
# PM2 restart policies it becomes a crash loop. Set true behind a load balancer,
# where failing the health check is better than serving a half-working instance.
REQUIRE_BROWSER_RUNTIME=false

# Extensions ONLY load in a headed Chrome, so on a server you need a virtual
# display first:  bash scripts/desktop.sh start
# Setting this to true starts faster but loads NO extensions.
# Profile: false in development (you want to SEE it), true in production
# (nothing is watching, and headless is cheaper).
#REAL_CHROME_HEADLESS=false
REAL_CHROME_DISPLAY=:99
REAL_CHROME_WINDOW_WIDTH=1280
REAL_CHROME_WINDOW_HEIGHT=800

# Reopen the tabs that were open when the browser last went away.
#
# The reported bug: a wedged Chromium was force-closed and the next one came
# up empty. MEASURED (tools/probe-realchrome-tab-loss.js): three tabs in,
# ZERO back -- and the same after a CLEAN close, so this was never a
# crash-only problem; Chrome was simply never asked to restore anything.
#
# Needs BOTH a profile preference and a launch flag: measured separately,
# each one alone still restored zero tabs. This setting drives both.
# Set false to get a fresh, empty window on every start.
# Profile: true everywhere. Losing half-finished tabs was the reported bug.
#REAL_CHROME_RESTORE_TABS=true

# Chrome's own DevTools endpoint — the literal "expose the browser on a port".
# 0 disables it. With it on you can attach any CDP client, or open
# chrome://inspect in your own Chrome and drive this one.
# SECURITY: an open DevTools port is remote code execution and full cookie theft
# for anyone who can reach it. Keep the bind address on 127.0.0.1 and tunnel:
#   ssh -N -L 9222:127.0.0.1:9222 you@server
# Profile: 0 in production and test -- an open port is remote code execution,
# so it is never on unless you ask for it here.
#REAL_CHROME_DEBUG_PORT=0
REAL_CHROME_DEBUG_BIND=127.0.0.1

# ============================================
# REMOTE DESKTOP (Xvfb + VNC + noVNC)
# ============================================
# Serves the X display over HTTP so the whole Chrome window opens in a browser
# tab — the only way to click an extension's toolbar button.
#   bash scripts/desktop.sh install
#   bash scripts/desktop.sh start
#   http://<server>:6080/vnc.html
# Profile: true in development (a visible browser needs a display to be
# visible on), false in production.
#DESKTOP_ENABLED=false
DESKTOP_VNC_PORT=5900
DESKTOP_NOVNC_PORT=6080
# Empty = no password. Only acceptable behind an SSH tunnel.
DESKTOP_VNC_PASSWORD=
# Override only if noVNC's static files are not in /usr/share/novnc.
DESKTOP_NOVNC_WEB_ROOT=

# Install Xvfb/x11vnc/websockify automatically when they are missing.
#
# This is what lets a NON-ROOT server bring its own display stack up: the
# packages are downloaded with `apt-get download` and unpacked into a private
# prefix, no sudo required. Leave it on unless your image already ships them or
# the host has no package mirror. Turning it OFF means a missing display is a
# hard failure instead of something the server fixes itself.
DESKTOP_AUTO_PROVISION=true

# Where that private prefix lives. Empty = <project>/.desktop-stack.
# Point this at a writable volume if the project directory is read-only.
DESKTOP_PROVISION_DIR=

# Run the display stack inside a user namespace (unshare). Off by default: it
# helps on hosts that forbid some syscalls, and breaks on hosts that forbid
# unprivileged namespaces, so it is opt-in after measuring your own box.
DESKTOP_USE_NAMESPACE=false

# ============================================
# QUEUE SETTINGS
# ============================================
MAX_CONCURRENT=20
MAX_QUEUED_JOBS_PER_USER=3
MAX_STORED_JOBS_PER_USER=10
QUEUE_DELAY_MS=200

# ============================================
# TIMEOUTS
# ============================================
STEP_TIMEOUT_MS=300000
MAX_JOB_DURATION_MINUTES=90
BROWSER_LAUNCH_TIMEOUT_MS=30000

# ============================================
# BROWSER
# ============================================
DEFAULT_HEADLESS=false
# Profile: false in development, so you can watch what it is doing.
#TURBO_MODE=false

# ============================================
# GARBAGE COLLECTOR
# ============================================
PARTIAL_SAVE_INTERVAL=10
GC_CHECK_INTERVAL_MINUTES=10
GC_STALE_THRESHOLD_MINUTES=15
PARTIAL_FILE_MAX_AGE_HOURS=1
JOB_OUTPUT_MAX_AGE_MS=1800000

# ============================================
# RATE LIMITING
# ============================================
# Profile: true in production (a public endpoint without one is a bill
# waiting to happen), false in development and test.
#RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=120
ADMIN_RATE_LIMIT_PER_MINUTE=30

# ============================================
# CORS (F5) - cross-origin access for the UI / n8n / extension
# ============================================
# Comma-separated allowed origins. Leave empty for same-origin only
# (the bundled dashboard works regardless). Use '*' to allow any origin
# (note: '*' disables credentials).
# Example: CORS_ALLOWED_ORIGINS=http://localhost:5678,https://n8n.example.com
CORS_ALLOWED_ORIGINS=
GOD_MODE_IPS=127.0.0.1,::1

# ============================================
# DEPLOYMENT MODE (H) - self-hosted single-user vs multi-tenant
# ============================================
# 'single' (default): self-hosted, full-access single user. Quota/VIP/Plan/Level
#   are disabled, the browser is fully available, and a single API_TOKEN
#   authenticates every request. Admin user-management endpoints are hidden.
# 'multi': original multi-tenant SaaS mode (per-user plans, quotas, admin).
DEPLOYMENT_MODE=single

# Shared token used to authenticate requests when DEPLOYMENT_MODE=single.
# Send it as: Authorization: Bearer <API_TOKEN>  (or x-api-key header).
#
# DEFAULT: admin123 (used when this is left empty). Convenient on a machine only
# you can reach, and stable across restarts - unlike the random token this used
# to generate, which logged every open panel out on every boot.
#
# !! THIS DEFAULT IS PUBLIC. It is in this file and in src/config.ts, so it is
# !! not a secret. Whoever has it controls the whole instance: it drives a real
# !! browser, reads/writes the download+upload directories, and runs workflows.
# !! If this host is reachable from the internet, replace it with your own.
# Ignored in multi mode (use API_KEYS instead).
API_TOKEN=admin123

# ============================================
# AUTHENTICATION
# ============================================
API_KEYS_ENABLED=true
API_KEYS=sk_live_replace_me_key1,sk_live_replace_me_key2
ADMIN_SECRET=replace_with_a_long_random_secret

# ============================================
# USER PLANS
# ============================================
DEFAULT_USER_LEVEL=0

# ============================================
# WEBHOOKS
# ============================================
WEBHOOK_TIMEOUT_MS=5000
WEBHOOK_ALLOW_PRIVATE_IPS=false
WEBHOOK_MAX_RETRIES=3
WEBHOOK_RETRY_BACKOFF_MS=1000
# [F3] Shared secret for signing outgoing webhooks (HMAC-SHA256). When set, each
# webhook carries X-Signature: sha256=<hex> and X-Webhook-Timestamp. Empty => unsigned.
WEBHOOK_SECRET=

# Fire a webhook after EVERY step, not just at job completion. Off by default:
# a long job would otherwise produce one HTTP request per step, which is a lot
# of traffic to opt somebody into silently.
STEP_WEBHOOK_ENABLED=false

# ============================================
# LIVE SHARE LINKS
# ============================================
# Signs the share links that let someone watch a running job without an API key.
# Falls back to WEBHOOK_SECRET, then API_TOKEN, so it usually needs no value.
# Set it explicitly if you want share links to survive an API_TOKEN rotation.
LIVE_SHARE_SECRET=

# How long a share link stays valid, in SECONDS. 0 = never expires.
LIVE_SHARE_TTL_SEC=86400


# ============================================
# n8n / API INTEGRATION (F3)
# ============================================
# POST /run?wait=true blocks until the job finishes, up to RUN_WAIT_MAX_MS, then
# returns the full result inline (202 + pollUrl on timeout). RUN_WAIT_POLL_MS is
# how often the server polls the job while waiting.
RUN_WAIT_MAX_MS=60000
RUN_WAIT_POLL_MS=500
# Idempotency-Key (header on POST /run) -> jobId mapping TTL in seconds (default 24h).
IDEMPOTENCY_TTL_SECONDS=86400

# ============================================
# WORKFLOW STORAGE (G2)
# ============================================
# Saved workflows are versioned; how many past versions to keep per workflow.
# Oldest snapshots beyond this are pruned on each update. 0 = keep all.
WORKFLOW_MAX_VERSIONS=20

# ============================================
# SECURITY
# ============================================
MAX_TOTAL_EXECUTION_OPS=5000
MAX_REQUEST_BODY_SIZE=20mb
MAX_REGEX_LENGTH=100
USE_LUA_QUOTA=true
MAX_VARIABLE_SIZE_KB=100

# Condition node: the in-viewport check waits this long for
# IntersectionObserver to fire (it never fires for a detached element).
CONDITION_IN_SCREEN_TIMEOUT_MS=1000
# Condition node: max length of a JavaScript condition snippet.
CONDITION_CODE_MAX_LENGTH=5000
# Condition node: budget for a JavaScript condition snippet. A runaway
# snippet wedges the page permanently, so this race is the only escape.
CONDITION_CODE_TIMEOUT_MS=5000

# ============================================
# HYBRID ARCHITECTURE (VIP vs Free)
# ============================================
VIP_PRIORITY_THRESHOLD=100
FREE_CONTEXT_MAX_LIFETIME_MS=600000
FREE_RESOURCE_BLOCKING=true
FREE_FORCE_SEQUENTIAL=true

# ============================================
# FLATTENER (Free Users Tab Control)
# ============================================
FREE_FLATTENER_ENABLED=true
FLATTENER_URL_CAPTURE_TIMEOUT_MS=2000
FLATTENER_REDIRECT_TO_MAIN=true

# ============================================
# CANCEL SETTINGS
# ============================================
TAB_CLOSE_TIMEOUT_MS=5000

# ============================================
# DUAL BROWSER MODE (Remote + Local)
# ============================================
# Which browser runs a user's automation. Remote = the browser on THIS server
# (the original behaviour, unchanged). Local = the user's own Chrome/Chromium on
# their machine, reached through a reverse CDP tunnel the AGENT dials out to us
# (tools/local-browser-agent.js). Both modes are official; local does not
# replace remote, and remote stays the fallback that always works.
#
# The mode a user gets before they ever choose one.
BROWSER_MODE_DEFAULT=remote

# Master switch for local mode. Set false to remove it from the UI entirely --
# a switch attempt then returns 409 with `local_disabled` instead of pretending.
LOCAL_BROWSER_ENABLED=true

# The CDP port the agent is told to use on the USER'S machine. Nothing is
# exposed here: the agent binds it to 127.0.0.1 and dials OUT to us over
# WebSocket, so no inbound port or firewall change is ever needed. (CDP has no
# authentication of its own, which is exactly why it is never exposed.)
LOCAL_BROWSER_CDP_PORT=9222

# How long Playwright waits to attach through the tunnel before giving up and
# saying so. A local browser is on someone's home network, so this is longer
# than a loopback connect would need.
LOCAL_BROWSER_CONNECT_TIMEOUT_MS=20000


USER_PLANS={"0":{"quota":5,"maxTabs":1,"maxSteps":5,"priority":100},"1":{"quota":15,"maxTabs":3,"maxSteps":20,"priority":50},"2":{"quota":60,"maxTabs":10,"maxSteps":100,"priority":10}}

# Schedule Limits
MAX_SCHEDULES_FREE=2
MAX_SCHEDULES_VIP=10
MAX_REPEAT_LIMIT_FREE=100
